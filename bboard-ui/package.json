{
    "name": "@midnight-ntwrk/bboard-ui",
    "version": "0.1.0",
    "author": "IOG",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\" && tsc && vite build --mode preprod && node ./scripts/copy-zk-assets.mjs",
        "build:preview": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\" && tsc && vite build --mode preview && node ./scripts/copy-zk-assets.mjs",
        "build:start": "npm run build && npm run start",
        "build:start:preview": "npm run build:preview && npm run start",
        "ci": "npm run typecheck && npm run lint",
        "dev": "vite",
        "lint": "eslint ./src",
        "start": "http-server --port 0 ./dist",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "preview": "vite preview",
        "prepack": "yarn build"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@midnight-ntwrk/compact-runtime": "0.16.0",
        "@midnight-ntwrk/dapp-connector-api": "^1.2.3",
        "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
        "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
        "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
        "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
        "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
        "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
        "@midnight-ntwrk/midnight-js-types": "4.1.1",
        "@midnight-ntwrk/midnight-js-utils": "4.1.1",
        "@mui/icons-material": "^6.4.1",
        "@mui/material": "^6.4.1",
        "fp-ts": "^2.16.9",
        "node-stdlib-browser": "^1.3.1",
        "pino": "^9.6.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.28.0",
        "rxjs": "^7.8.1",
        "semver": "^7.6.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.20.0",
        "@swc/core": "^1.15.41",
        "@types/node": "^25.9.5",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@types/semver": "^7.7.1",
        "@vitejs/plugin-react": "^4.3.4",
        "eslint": "^9.20.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "eslint-plugin-react": "^7.37.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.24.0",
        "vite": "^5.4.11",
        "vite-plugin-node-polyfills": "^0.28.0",
        "vite-plugin-top-level-await": "^1.4.4",
        "vite-plugin-wasm": "^3.3.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.22.4",
        "@swc/core-linux-x64-gnu": "^1.15.41"
    }
}
