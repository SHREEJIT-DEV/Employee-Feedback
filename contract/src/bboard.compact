pragma language_version 0.23;

import CompactStandardLibrary;

export enum State {
  VACANT,
  OCCUPIED
}

export ledger state: State;

export ledger message: Maybe<Opaque<"string">>;

export ledger sequence: Counter;

export ledger owner: Bytes<32>;

export ledger totalFeedbackCount: Counter;

export ledger totalRatingSum: Counter;

export ledger lastCategory: Maybe<Opaque<"string">>;

export ledger lastFeedbackDigest: Bytes<32>;

constructor() {
  state = State.VACANT;
  message = none<Opaque<"string">>();
  sequence.increment(1);
  lastCategory = none<Opaque<"string">>();
  lastFeedbackDigest = pad(32, "");
}

witness localSecretKey(): Bytes<32>;

export circuit post(newMessage: Opaque<"string">): [] {
  assert(state == State.VACANT, "Attempted to post to an occupied board");
  owner = disclose(publicKey(localSecretKey(), sequence as Field as Bytes<32>));
  message = disclose(some<Opaque<"string">>(newMessage));
  state = State.OCCUPIED;
}

export circuit takeDown(): Opaque<"string"> {
  assert(state == State.OCCUPIED, "Attempted to take down post from an empty board");
  assert(owner == publicKey(localSecretKey(), sequence as Field as Bytes<32>), "Attempted to take down post, but not the current owner");
  const formerMsg = message.value;
  state = State.VACANT;
  sequence.increment(1);
  message = none<Opaque<"string">>();
  return formerMsg;
}

export circuit submitFeedback(
  ratingScore: Uint<8>,
  category: Opaque<"string">,
  feedbackDigest: Bytes<32>
): [] {
  assert(ratingScore >= 1, "Rating must be at least 1");
  assert(ratingScore <= 5, "Rating must be at most 5");

  const pk = publicKey(localSecretKey(), sequence as Field as Bytes<32>);
  assert(pk != pad(32, ""), "Invalid employee witness");

  totalFeedbackCount.increment(1);
  totalRatingSum.increment(disclose(ratingScore as Uint<16>));
  lastCategory = disclose(some<Opaque<"string">>(category));
  lastFeedbackDigest = disclose(feedbackDigest);
}

export circuit publicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "bboard:pk:"), sequence, sk]);
}
